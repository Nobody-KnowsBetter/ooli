# DocGuard Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Verification engine: qwen (local model through Ollama) or heuristic (no model)
DOCGUARD_AI_PROVIDER=qwen
# To run Qwen on another machine (EC2, a teammate's laptop), point this at it.
# Ollama has no login, so reach it through an SSH tunnel or a private network, never the open internet.
OLLAMA_URL=http://127.0.0.1:11434
DOCGUARD_MODEL=qwen2.5-coder:3b

# GitHub login. Create an OAuth App at https://github.com/settings/developers
# with this callback URL: http://localhost:3000/api/auth/callback
# Leave these empty to run without login.
APP_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: verifies webhooks sent by GitHub
GITHUB_WEBHOOK_SECRET=

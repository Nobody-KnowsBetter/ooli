# DocGuard Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Verification engine: qwen (local model through Ollama) or heuristic (no model)
DOCGUARD_AI_PROVIDER=qwen
OLLAMA_URL=http://127.0.0.1:11434
DOCGUARD_MODEL=qwen2.5-coder:3b

# Optional: verifies webhooks sent by GitHub
GITHUB_WEBHOOK_SECRET=

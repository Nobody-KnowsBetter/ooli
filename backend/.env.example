# DocGuard Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# AI Intelligence Engine Provider (gemini | openai | anthropic | heuristic)
DOCGUARD_AI_PROVIDER=heuristic
# Optional: Set your preferred API key to enable semantic LLM reasoning
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub Integration (Optional for local CLI, required for Webhook/GitHub App)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Database
DATABASE_URL=sqlite:///./docguard.db

